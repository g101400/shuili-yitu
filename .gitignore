# ===== 水利工程基础信息一张图 工程级忽略规则（独立仓库，不再依赖 gujian4060 单体 .gitignore）=====

# 本地密钥 / 真实配置（绝不上传）
secrets/
*.local.js
*.keystore
*.jks

# 构建产物 / 包（绝不上传）
node_modules/
dist/
build/tmp/
build/output/
*.apk
*.aab
*.exe
*.msi
*.deb
*.zip
*.pdb
*.dll
bin/
obj/
publish/
publish_v331/

# 工作区 / 凭据
.workbuddy/
.github_token

# 离线瓦片与清单（体积大，可再生成；运行需要但用本地缓存）
offline_tiles/
native-shell/*/webroot/offline_tiles/

# 真实密钥文件：只保留 *.demo.js 模板
ai_seed.js
native-shell/*/webroot/ai_seed.js
webroot/ai_seed.js

# 历史备份目录（含旧 API 密钥副本，严禁入库）
*_bak_*/
*.bak
*.bak_*
__pycache__/
*.pyc

# iOS 历史发布包（体积大，不入库；保留构建脚本）
native-shell/water-ios/apple-package/
native-shell/water-ios/本地部署/
